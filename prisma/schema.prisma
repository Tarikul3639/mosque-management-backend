// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/lib/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// ===========================
/// ENUMS
/// ===========================

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CommitteeRole {
  PRESIDENT
  VICE_PRESIDENT
  SECRETARY
  ASSISTANT_SECRETARY
  TREASURER
  MEMBER
  IMAM
  MUAZZIN
}

// Future-ready. Add BKASH/NAGAD/CARD/QR usage without breaking existing rows.
enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  BANK_TRANSFER
  CARD
  QR
  OTHER
}

enum ExpenseCategory {
  IMAM_SALARY
  MUAZZIN_SALARY
  ELECTRICITY
  WATER
  CLEANING
  MAINTENANCE
  DEVELOPMENT
  OTHER
}

enum ProjectStatus {
  PLANNING
  RUNNING
  COMPLETED
  CANCELLED
}

enum Month {
  JANUARY
  FEBRUARY
  MARCH
  APRIL
  MAY
  JUNE
  JULY
  AUGUST
  SEPTEMBER
  OCTOBER
  NOVEMBER
  DECEMBER
}

enum PaymentStatus {
  DUE
  PAID
  PARTIAL
}

/// ===========================
/// ROLE
/// ===========================

model Role {
  id          String   @id @default(uuid())
  name        UserRole @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

/// ===========================
/// USER
/// ===========================

model User {
  id               String     @id @default(uuid())
  roleId           String
  role             Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  fullName         String
  email            String     @unique
  phone            String     @unique
  password         String
  avatar           String?
  status           UserStatus @default(ACTIVE)
  lastLoginAt      DateTime?
  createdExpenses  Expense[]  @relation("ExpenseCreatedBy")
  updatedExpenses  Expense[]  @relation("ExpenseUpdatedBy")
  createdDonations Donation[] @relation("DonationCreatedBy")
  updatedDonations Donation[] @relation("DonationUpdatedBy")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([status])
  @@index([roleId])
  @@map("users")
}

/// ===========================
/// COMMITTEE MEMBER
/// ===========================

model CommitteeMember {
  id          String        @id @default(uuid())
  fullName    String
  designation CommitteeRole
  phone       String
  email       String?
  avatar      String?
  address     String?
  joiningDate DateTime?
  endDate     DateTime?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([designation])
  @@index([isActive])
  @@map("committee_members")
}

/// ===========================
/// FAMILY
/// ===========================

model Family {
  id         String          @id @default(cuid())
  familyNo   String          @unique
  headName   String
  avatar     String?
  phone      String?
  address    String?
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  feeHistory FamilyFee[]
  payments   Payment[]
  charges    MonthlyCharge[]
}

model FamilyFee {
  id         String    @id @default(cuid())
  familyId   String
  family     Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  monthlyFee Decimal   @db.Decimal(10, 2)
  startDate  DateTime
  endDate    DateTime?
  createdAt  DateTime  @default(now())
}

model Payment {
  id              String        @id @default(cuid())
  familyId        String
  family          Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  monthlyChargeId String
  monthlyCharge   MonthlyCharge @relation(fields: [monthlyChargeId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(10, 2)
  paidAt          DateTime      @default(now())
  method          PaymentMethod @default(CASH)
  reference       String?
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([familyId])
  @@index([monthlyChargeId])
}

model MonthlyCharge {
  id         String        @id @default(cuid())
  familyId   String
  family     Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  year       Int
  month      Int
  amount     Decimal       @db.Decimal(10, 2)
  paidAmount Decimal       @default(0) @db.Decimal(10, 2)
  status     PaymentStatus @default(DUE)
  payments   Payment[]
  dueDate    DateTime?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([familyId, year, month])
  @@index([familyId])
  @@index([year, month])
}

/// ===========================
/// DONOR
/// ===========================

model Donor {
  id        String     @id @default(uuid())
  fullName  String
  phone     String
  address   String?
  email     String?
  avatar    String?
  isActive  Boolean    @default(true)
  donations Donation[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([fullName, phone])
  @@index([phone])
  @@index([fullName])
  @@map("donors")
}

/// ===========================
/// DONATION
/// ===========================

model Donation {
  id      String  @id @default(uuid())
  donorId String
  donor   Donor   @relation(fields: [donorId], references: [id], onDelete: Restrict)
  amount  Decimal @db.Decimal(10, 2)

  createdById String?
  createdBy   User?   @relation("DonationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?   @relation("DonationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  purpose              String?
  isAnonymous          Boolean       @default(false)
  receiptNo            String        @unique
  paymentMethod        PaymentMethod @default(CASH)
  transactionReference String?
  note                 String?
  donatedAt            DateTime      @default(now())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([donorId])
  @@index([donatedAt])
  @@index([paymentMethod])
  @@index([createdById])
  @@index([updatedById])
  @@map("donations")
}

/// ===========================
/// EXPENSE
/// ===========================

model Expense {
  id          String          @id @default(uuid())
  category    ExpenseCategory
  title       String
  amount      Decimal         @db.Decimal(10, 2)
  note        String?
  expenseDate DateTime
  createdById String?
  createdBy   User?           @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?           @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category])
  @@index([expenseDate])
  @@index([createdById])
  @@index([updatedById])
  @@map("expenses")
}

/// ===========================
/// DEVELOPMENT PROJECT
/// ===========================

model DevelopmentProject {
  id          String        @id @default(uuid())
  title       String
  description String?
  budget      Decimal?      @db.Decimal(10, 2)
  spent       Decimal?      @db.Decimal(10, 2)
  progress    Int           @default(0)
  image       String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([startDate])
  @@index([status])
  @@map("development_projects")
}

/// ===========================
/// GALLERY
/// ===========================

model Gallery {
  id          String   @id @default(uuid())
  title       String?
  imageUrl    String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@map("galleries")
}

/// ===========================
/// PRAYER TIME
/// ===========================

model PrayerTime {
  id        String   @id @default(uuid())
  fajr      String
  dhuhr     String
  asr       String
  maghrib   String
  isha      String
  jummah    String?
  sunrise   String?
  updatedAt DateTime @updatedAt

  @@map("prayer_times")
}

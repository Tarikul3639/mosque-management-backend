generator client {
  provider     = "prisma-client"
  output       = "../src/lib/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(uuid())
  name        UserRole @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("roles")
}

model User {
  id                         String               @id @default(uuid())
  roleId                     String
  name                       String
  email                      String               @unique
  phone                      String               @unique
  password                   String
  avatarId                   String?              @unique
  status                     UserStatus           @default(ACTIVE)
  lastLoginAt                DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  createdDevelopmentProjects DevelopmentProject[] @relation("DevelopmentProjectCreatedBy")
  updatedDevelopmentProjects DevelopmentProject[] @relation("DevelopmentProjectUpdatedBy")
  createdDonations           Donation[]           @relation("DonationCreatedBy")
  updatedDonations           Donation[]           @relation("DonationUpdatedBy")
  createdExpenses            Expense[]            @relation("ExpenseCreatedBy")
  updatedExpenses            Expense[]            @relation("ExpenseUpdatedBy")
  updatedFiles               File[]               @relation("FileUpdatedBy")
  uploadedFiles              File[]               @relation("FileUploadedBy")
  createdGalleries           Gallery[]            @relation("GalleryCreatedBy")
  updatedGalleries           Gallery[]            @relation("GalleryUpdatedBy")
  avatar                     File?                @relation(fields: [avatarId], references: [id])
  role                       Role                 @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([status])
  @@map("users")
}

model CommitteeMember {
  id          String        @id @default(uuid())
  name        String
  designation CommitteeRole
  phone       String
  email       String?
  avatarId    String?       @unique
  address     String?
  joiningDate DateTime?
  endDate     DateTime?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  avatar      File?         @relation(fields: [avatarId], references: [id])

  @@index([designation])
  @@index([isActive])
  @@map("committee_members")
}

model Family {
  id         String          @id @default(uuid())
  familyNo   String          @unique
  headName   String
  avatarId   String?         @unique
  phone      String?
  address    String?
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  feeHistory FamilyFee[]
  charges    MonthlyCharge[]
  payments   Payment[]
  avatar     File?           @relation(fields: [avatarId], references: [id])

  @@index([isActive])
  @@map("families")
}

model FamilyFee {
  id         String    @id @default(cuid())
  familyId   String
  monthlyFee Decimal   @db.Decimal(10, 2)
  startDate  DateTime
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  family     Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(cuid())
  familyId        String
  monthlyChargeId String
  amount          Decimal       @db.Decimal(10, 2)
  paidAt          DateTime      @default(now())
  method          PaymentMethod @default(CASH)
  reference       String?
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  family          Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  monthlyCharge   MonthlyCharge @relation(fields: [monthlyChargeId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([monthlyChargeId])
}

model MonthlyCharge {
  id         String        @id @default(cuid())
  familyId   String
  year       Int
  month      Int
  amount     Decimal       @db.Decimal(10, 2)
  paidAmount Decimal       @default(0) @db.Decimal(10, 2)
  status     PaymentStatus @default(DUE)
  dueDate    DateTime?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  family     Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  payments   Payment[]

  @@unique([familyId, year, month])
  @@index([familyId])
  @@index([year, month])
}

model Donor {
  id        String     @id @default(uuid())
  name      String
  phone     String
  email     String?
  address   String?
  avatarId  String?    @unique
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  donations Donation[]
  avatar    File?      @relation(fields: [avatarId], references: [id])

  @@unique([name, phone])
  @@index([name])
  @@index([phone])
  @@map("donors")
}

model Donation {
  id                   String        @id @default(uuid())
  donorId              String
  amount               Decimal       @db.Decimal(10, 2)
  createdById          String?
  updatedById          String?
  purpose              String?
  isAnonymous          Boolean       @default(false)
  receiptNo            String        @unique
  paymentMethod        PaymentMethod @default(CASH)
  transactionReference String?
  note                 String?
  donatedAt            DateTime      @default(now())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  createdBy            User?         @relation("DonationCreatedBy", fields: [createdById], references: [id])
  donor                Donor         @relation(fields: [donorId], references: [id])
  updatedBy            User?         @relation("DonationUpdatedBy", fields: [updatedById], references: [id])

  @@index([donorId])
  @@index([donatedAt])
  @@index([paymentMethod])
  @@index([createdById])
  @@index([updatedById])
  @@map("donations")
}

model Expense {
  id          String          @id @default(uuid())
  category    ExpenseCategory
  title       String
  amount      Decimal         @db.Decimal(10, 2)
  note        String?
  expenseDate DateTime
  createdById String?
  updatedById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   User?           @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?           @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id])

  @@index([category])
  @@index([expenseDate])
  @@index([createdById])
  @@index([updatedById])
  @@map("expenses")
}

model DevelopmentProject {
  id          String        @id @default(uuid())
  title       String
  description String?
  budget      Decimal?      @db.Decimal(10, 2)
  spent       Decimal?      @db.Decimal(10, 2)
  progress    Int           @default(0)
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   User?         @relation("DevelopmentProjectCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?         @relation("DevelopmentProjectUpdatedBy", fields: [updatedById], references: [id])
  images      File[]        @relation("DevelopmentProjectToFile")

  @@index([status])
  @@index([startDate])
  @@index([createdById])
  @@index([updatedById])
  @@map("development_projects")
}

model Gallery {
  id          String   @id @default(uuid())
  title       String?
  description String?
  order       Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("GalleryCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("GalleryUpdatedBy", fields: [updatedById], references: [id])
  images      File[]   @relation("FileToGallery")

  @@index([order])
  @@index([createdById])
  @@index([updatedById])
  @@map("galleries")
}

model PrayerTime {
  id        String   @id @default(uuid())
  fajr      String
  sunrise   String?
  dhuhr     String
  asr       String
  maghrib   String
  isha      String
  jummah    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("prayer_times")
}

model File {
  id              String               @id @default(uuid())
  url             String
  publicId        String               @unique
  originalName    String?
  mimeType        String?
  extension       String?
  size            Int
  width           Int?
  height          Int?
  uploadedById    String?
  updatedById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  committeeAvatar CommitteeMember?
  donorAvatar     Donor?
  familyAvatar    Family?
  updatedBy       User?                @relation("FileUpdatedBy", fields: [updatedById], references: [id])
  uploadedBy      User?                @relation("FileUploadedBy", fields: [uploadedById], references: [id])
  userAvatar      User?
  projects        DevelopmentProject[] @relation("DevelopmentProjectToFile")
  galleries       Gallery[]            @relation("FileToGallery")

  @@index([uploadedById])
  @@index([updatedById])
  @@map("files")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CommitteeRole {
  PRESIDENT
  VICE_PRESIDENT
  SECRETARY
  ASSISTANT_SECRETARY
  TREASURER
  MEMBER
  IMAM
  MUAZZIN
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  BANK_TRANSFER
  CARD
  QR
  OTHER
}

enum ExpenseCategory {
  IMAM_SALARY
  MUAZZIN_SALARY
  ELECTRICITY
  WATER
  INTERNET
  GAS
  MAINTENANCE
  CLEANING
  DEVELOPMENT
  OFFICE
  EVENT
  OTHER
}

enum ProjectStatus {
  PLANNING
  RUNNING
  COMPLETED
  CANCELLED
}

enum Month {
  JANUARY
  FEBRUARY
  MARCH
  APRIL
  MAY
  JUNE
  JULY
  AUGUST
  SEPTEMBER
  OCTOBER
  NOVEMBER
  DECEMBER
}

enum PaymentStatus {
  DUE
  PAID
  PARTIAL
}

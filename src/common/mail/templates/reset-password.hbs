<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
  </head>
  <body style="margin: 0; background: transparent; color: #24292f; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 14px; line-height: 1.6;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td>
          <!-- Header -->
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin: 28px 0 28px;">
            <tr>
              <td align="left" style="padding: 0;">
                <table role="presentation" cellpadding="0" cellspacing="0">
                  <tr>
                    <td valign="middle">
                      <img src="{{logoUrl}}" alt="{{appName}}" width="65" height="65" style="display: block; border: 0; outline: none; text-decoration: none;" />
                    </td>
                    <td valign="middle" style="padding-left: 12px;">
                      <div style="color: #16A34A; font-size: 20px; font-weight: 700; line-height: 1.2;">
                        {{appName}}
                      </div>
                      <div style="margin-top: 2px; color: #57606A; font-size: 12px; line-height: 1.2;">
                        Mosque Management System
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>

          <h1 style="margin: 0 0 12px; font-size: 17px; line-height: 1.3; font-weight: 600;">
            Reset your password
          </h1>

          <p style="margin: 0 0 24px; color: #57606a;">
            Hi <strong>{{userName}}</strong>,
            <br /><br />
            We received a request to reset the password for your account. If you made this request, click the button below to create a new password.
          </p>

          <p style="margin: 28px 0;">
            <a href="{{resetPasswordUrl}}" style="display: inline-block; padding: 10px 18px; background: #16A34A; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 500;">
              Reset password
            </a>
          </p>

          <p style="margin: 0 0 24px; color: #57606a;">
            This link will expire in <strong>{{expireIn}}</strong>.
          </p>

          <p style="margin: 0 0 24px; color: #57606a;">
            If the button above doesn't work, copy and paste the following URL into your browser:
          </p>

          <p style="margin: 0 0 28px; word-break: break-all;">
            <a href="{{resetPasswordUrl}}" style="color: #0969da;">
              {{resetPasswordUrl}}
            </a>
          </p>

          <hr style="border: none; border-top: 1px solid #d8dee4; margin: 0 0 20px;" />

          <p style="margin: 0 0 12px; color: #57606a;">
            If you didn't request a password reset, you can safely ignore this email. Your password won't be changed.
          </p>

          <p style="margin: 24px 0 0; font-size: 13px; color: #8c959f;">
            Thanks,<br />
            <strong>{{appName}}</strong>
          </p>

          <p style="margin: 16px 0 0; font-size: 12px; color: #8c959f;">
            &copy; {{year}} {{appName}}. All rights reserved.
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>